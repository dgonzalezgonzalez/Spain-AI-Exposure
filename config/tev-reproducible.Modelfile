FROM tev1:4b
# System One reports candidate probabilities; sampled tokens do not enter them.
# Runtime parameters must live here: /v1/systemone ignores request options.
PARAMETER num_ctx 32768
PARAMETER num_batch 128
PARAMETER num_thread 4
PARAMETER num_gpu 999
PARAMETER seed 20261005
PARAMETER temperature 0
PARAMETER top_k 1
PARAMETER top_p 1
PARAMETER min_p 0
PARAMETER repeat_penalty 1
